# Copy this file to .env (same folder, project root) and fill in your real key.
# .env should already be covered by your existing .gitignore -- never commit real keys.

OPENROUTER_API_KEY=replace_with_your_openrouter_api_key

# Required only for authenticated Phase 6 webhooks; replace with a long random value.
WEBHOOK_SHARED_SECRET=replace_with_a_long_random_webhook_secret

# Optional -- used only for OpenRouter's attribution headers / analytics.
OPENROUTER_SITE_URL=https://opspilot.local
OPENROUTER_APP_NAME=OpsPilot-AI
